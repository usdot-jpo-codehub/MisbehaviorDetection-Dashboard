FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt requirements-ode.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ode.txt

COPY detectors/ detectors/
COPY detector.py bsm_agent.py ode_config.json ./

RUN mkdir -p /mbd/logs

CMD ["python", "bsm_agent.py", "--log", "/mbd/logs/misbehaviors.log"]
